    <style name="PreferenceTheme" parent="PreferenceThemeOverlay"/>
    <style name="Theme.ICSLauncher" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:textColorPrimary">@color/colorOnSurface</item>
        <item name="android:textColorSecondary">@color/colorOnSurfaceVariant</item>
        <item name="dividerColor">@color/colorDivider</item>
    </style>
    <style name="Theme.ICSLauncher.Dialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:textColorPrimary">@color/colorOnSurface</item>
    </style>
    <style name="Theme.ICSLauncher.NoActionBar" parent="Theme.ICSLauncher">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="Widget.ICSLauncher.CalculatorDisplay" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">32sp</item>
        <item name="android:gravity">bottom|right</item>
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>
    <style name="Widget.ICSLauncher.IconButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">4dp</item>
    </style>
    <style name="Widget.ICSLauncher.SearchBar" parent="Widget.AppCompat.SearchView">
        <item name="queryHint">@string/search</item>
        <item name="android:iconifiedByDefault">false</item>
        <item name="android:focusable">true</item>
        <item name="android:textColorPrimary">@color/colorOnSurface</item>
        <item name="android:textColorHint">@color/colorOnSurfaceVariant</item>
    </style>
    <style name="Widget.ICSLauncher.WallpaperItem" parent="">
        <item name="android:background">@android:color/transparent</item>
    </style>
